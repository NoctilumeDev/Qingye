<view wx:if="{{!hidden}}" class="tab-wrap"><view class="tabs">
  <view wx:for="{{tabs}}" wx:key="path" class="tab {{item.assistant ? 'tab-assistant' : ''}} {{selectedPath === item.path ? 'active' : ''}}" data-index="{{index}}" bindtap="switchTab" aria-role="button" aria-label="{{item.label}}" aria-current="{{selectedPath === item.path ? 'page' : 'false'}}"><image class="icon" src="/assets/icons/{{selectedPath === item.path ? item.activeIcon : item.icon}}.png" /><text>{{item.label}}</text></view>
</view></view>
