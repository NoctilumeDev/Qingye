<view class="page home">
  <view class="brand"><image src="/assets/icons/sparkling-fill-green.png" /><text>青野</text><text class="brand-en">QINGYE</text></view>
  <view class="brand-caption">和有趣的人，一起在校园里见面。</view>
  <view class="search" bindtap="search" aria-role="button" aria-label="搜索活动"><image src="/assets/icons/search-line-muted.png" /><text>搜活动，找到想去的那一场</text></view>
  <campus-carousel images="{{heroImages}}" active="{{visible}}" />
  <view class="shortcuts">
    <view class="shortcut" bindtap="activities" hover-class="shortcut-pressed"><view class="shortcut-icon blue"><image src="/assets/icons/calendar-event-line-blue.png" /></view><text>校园活动</text></view>
    <view class="shortcut" bindtap="clubs" hover-class="shortcut-pressed"><view class="shortcut-icon blue"><image src="/assets/icons/team-line-green.png" /></view><text>找同好</text></view>
    <view class="shortcut" bindtap="myActivities" hover-class="shortcut-pressed" aria-role="button" aria-label="查看我的活动"><view class="shortcut-icon green"><image src="/assets/icons/time-line-ink.png" /></view><text>我的活动</text></view>
    <view class="shortcut" bindtap="assistant" hover-class="shortcut-pressed"><view class="shortcut-icon orange"><image src="/assets/icons/chat-smile-2-line-orange.png" /></view><text>问问青野</text></view>
  </view>
  <view class="recommendation-panel" wx:if="{{recommendations.length}}" bindtouchstart="pauseRecommendations">
    <view class="recommendation-heading"><text class="section-title">可能正合你意</text><view class="more" bindtap="activities">查看全部<image src="/assets/icons/arrow-right-s-line-muted.png" /></view></view>
    <swiper class="recommendation-carousel" current="{{recommendationIndex}}" autoplay="{{visible && recommendationsPlaying && recommendationPages.length > 1}}" circular="{{recommendationPages.length > 1}}" interval="6500" duration="450" easing-function="easeOutCubic" bindchange="recommendationChange">
      <swiper-item class="recommendation-slide" wx:for="{{recommendationPages}}" wx:for-item="recommendationPage" wx:key="index">
        <view class="recommendation-pair"><activity-card class="recommendation-entry" wx:for="{{recommendationPage}}" wx:key="id" item="{{item}}" variant="tile" bindopen="open" /></view>
      </swiper-item>
    </swiper>
    <view wx:if="{{recommendationPages.length > 1}}" class="recommendation-controls">
      <view class="carousel-dots"><view wx:for="{{recommendationPages}}" wx:key="index" class="carousel-dot {{recommendationIndex === index ? 'carousel-dot-active' : ''}}" /></view>
    </view>
  </view>
  <view wx:if="{{!recommendations.length}}" class="empty">{{loading ? '正在找适合你的活动…' : failed ? '推荐暂时没加载出来' : '暂时没有推荐活动'}}<view class="gap"><qy-action variant="secondary" bindactivate="activities">查看全部活动</qy-action></view></view>
</view>
