.home {
  padding-top:16rpx;
}

.brand {
  display:flex;
  align-items:center;
  gap:9rpx;
  font-size:36rpx;
  font-weight:750;
}

.brand > image {
  width:45rpx;
  height:45rpx;
}

.brand-en {
  font-size:18rpx;
  letter-spacing:3rpx;
  margin-left:auto;
  color:#65767d;
  font-weight:500;
}

.brand-caption {
  color:#65767d;
  font-size:22rpx;
  margin:10rpx 0 19rpx;
}

.search {
  display:flex;
  align-items:center;
  gap:13rpx;
  background:#edf2f4;
  padding:16rpx 22rpx;
  border-radius:40rpx;
  margin-bottom:20rpx;
}

.search > image {
  width:32rpx;
  height:32rpx;
}

.search text { color:#65767d; font-size:24rpx; line-height:42rpx; }

.carousel-dots {
  display:flex;
  align-items:center;
  gap:9rpx;
}

.carousel-dot {
  width:8rpx;
  height:8rpx;
  border-radius:8rpx;
  background:#cdded7;
  transition:width 250ms ease,background 250ms ease;
}

.carousel-dot-active {
  width:24rpx;
  background:#187553;
}

.shortcuts {
  display:flex;
  justify-content:space-between;
  padding:25rpx 8rpx 0;
}

.shortcut {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12rpx;
  min-width:120rpx;
  font-size:23rpx;
}

.shortcut-pressed {
  opacity:.65;
}

.shortcut-icon {
  width:78rpx;
  height:78rpx;
  border-radius:28rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.shortcut-icon > image {
  width:47rpx;
  height:47rpx;
}

.shortcut-icon.blue {
  background:#e4f1fa;
}

.shortcut-icon.green {
  background:#e3f0e9;
}

.shortcut-icon.orange {
  background:#fcf0df;
}

.section {
  margin:35rpx 0 20rpx;
}

.more {
  display:flex;
  align-items:center;
  color:#65767d;
  font-size:22rpx;
  min-height:54rpx;
}

.more > image {
  width:26rpx;
  height:26rpx;
}

.recommendation-panel {
  margin-top:35rpx;
  padding:22rpx;
  background:#fff;
  border:1rpx solid #e3ece7;
  border-radius:30rpx;
  overflow:hidden;
}

.recommendation-heading {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:18rpx;
}

.recommendation-carousel {
  height:490rpx;
  margin:0 -8rpx;
  overflow:hidden;
  border-radius:22rpx;
}

.recommendation-slide {
  box-sizing:border-box;
  padding:0 8rpx;
}

.recommendation-pair {
  display:flex;
  gap:16rpx;
}

.recommendation-entry {
  display:block;
  width:calc((100% - 16rpx) / 2);
  flex-shrink:0;
  min-width:0;
}

.recommendation-controls {
  display:flex;
  align-items:center;
  justify-content:center;
  height:32rpx;
  padding-top:8rpx;
}
