.home {
  padding-top:16rpx;
}

.brand {
  display:flex;
  align-items:center;
  gap:9rpx;
  font-size:36rpx;
  font-weight:750;
}

.brand > image {
  width:45rpx;
  height:45rpx;
}

.brand-en {
  font-size:18rpx;
  letter-spacing:3rpx;
  margin-left:auto;
  color:#65767d;
  font-weight:500;
}

.brand-caption {
  color:#65767d;
  font-size:22rpx;
  margin:10rpx 0 19rpx;
}

.search {
  display:flex;
  align-items:center;
  gap:13rpx;
  background:#edf2f4;
  padding:16rpx 22rpx;
  border-radius:40rpx;
  margin-bottom:20rpx;
}

.search > image {
  width:32rpx;
  height:32rpx;
}

.search input {
  flex:1;
  min-width:0;
  font-size:24rpx;
  height:42rpx;
}

.hero {
  height:515rpx;
  border-radius:26rpx;
  overflow:hidden;
  background:#e1eff6;
}

.hero > image {
  width:100%;
  height:100%;
  display:block;
}

.shortcuts {
  display:flex;
  justify-content:space-between;
  padding:25rpx 8rpx 0;
}

.shortcut {
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:12rpx;
  min-width:120rpx;
  font-size:23rpx;
}

.shortcut-pressed {
  opacity:.65;
}

.shortcut-icon {
  width:78rpx;
  height:78rpx;
  border-radius:28rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.shortcut-icon > image {
  width:47rpx;
  height:47rpx;
}

.shortcut-icon.blue {
  background:#e4f1fa;
}

.shortcut-icon.green {
  background:#e3f0e9;
}

.shortcut-icon.orange {
  background:#fcf0df;
}

.section {
  margin:35rpx 0 20rpx;
}

.more {
  display:flex;
  align-items:center;
  color:#65767d;
  font-size:22rpx;
  min-height:54rpx;
}

.more > image {
  width:26rpx;
  height:26rpx;
}

.recommendation-grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:18rpx;
  align-items:stretch;
}

.recommendation-grid > activity-card {
  min-width:0;
}

.chips {
  white-space:nowrap;
  margin-bottom:24rpx;
}

.chip {
  display:inline-block;
  padding:13rpx 26rpx;
  font-size:24rpx;
  color:#6c7c82;
  background:#edf2f4;
  border-radius:32rpx;
  margin-right:12rpx;
}

.chip.selected {
  background:#187553;
  color:#fff;
}
