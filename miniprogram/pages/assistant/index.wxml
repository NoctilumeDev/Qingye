<view class="page assistant-page">
  <view class="assistant-hero"><view class="assistant-brand"><image src="/assets/icons/sparkling-fill-green.png" /><text class="eyebrow">ASK QINGYE</text></view></view>
  <block wx:if="{{!status && !busy && !recoveryMessage}}">
    <view class="title">今天想找什么？</view><view class="subtitle">活动、器材，或者你自己的记录。</view>
    <view class="ask-card"><view class="field"><textarea class="textarea ask-input" value="{{question}}" focus="{{correcting}}" maxlength="300" bindinput="input" bindfocus="focusQuestion" bindblur="blurQuestion" bindkeyboardheightchange="keyboardChange" adjust-position="{{false}}" placeholder="例如：明天摄影社活动在哪里？" placeholder-style="color:#8a989c" /></view><view id="assistant-query"><qy-action variant="primary" bindactivate="ask">帮我找找</qy-action></view><view class="ask-note">我帮你查信息，报名和借用由你自己决定。</view></view>
    <view class="examples"><view class="examples-label">也可以试试</view><view class="suggestions"><view wx:for="{{suggestions}}" wx:key="*this" class="suggestion" data-question="{{item}}" bindtap="suggestion"><text>{{item}}</text><image src="/assets/icons/arrow-right-up-line-green.png" /></view></view></view>
  </block>
  <view wx:else class="question-context"><view class="question-copy"><text class="question-label">你想找</text><text class="question-value">{{question || '继续刚才的查找'}}</text></view><view wx:if="{{!busy}}" class="question-action"><qy-action variant="secondary" size="compact" bindactivate="editQuestion">重新提问</qy-action></view></view>
  <view wx:if="{{busy}}" class="loading">正在帮你找…</view>
  <view wx:if="{{clarificationToken}}" class="card clarification-card">
    <view class="clarification-label">青野想确认</view><text class="question-text">{{followupQuestion || '你想调整哪个条件？'}}</text>
    <textarea id="clarification-input" class="textarea reply-input" value="{{replyText}}" maxlength="300" bindinput="replyInput" bindfocus="focusReply" bindblur="blurQuestion" bindkeyboardheightchange="keyboardChange" adjust-position="{{false}}" disabled="{{busy}}" placeholder="在这里告诉我就好" />
    <view id="clarification-submit"><qy-action variant="primary" bindactivate="reply" loading="{{busy}}" disabled="{{busy}}">继续找</qy-action></view>
    <view wx:if="{{draftSummaries.length || missingConditions.length}}" class="context-toggle" bindtap="toggleContext">{{contextOpen ? '收起已保留的条件 ∧' : '看看已保留的条件 ∨'}}</view>
    <block wx:if="{{contextOpen}}"><view wx:for="{{draftSummaries}}" wx:key="_key" class="saved-condition">{{item.text}}</view><view wx:for="{{missingConditions}}" wx:key="_key" class="muted">第 {{item.queryIndex}} 项还缺：{{item.label}}</view></block>
  </view>
  <include src="../../views/assistant-results.wxml" />
  <view wx:if="{{retryToken}}" class="retry-button"><qy-action variant="secondary" bindactivate="retry" disabled="{{busy}}">再试一次</qy-action></view>
  <view wx:if="{{!busy}}" class="manual-entry"><view class="manual-header" bindtap="toggleDirectory" hover-class="facet-toggle-pressed" aria-role="button"><view><view class="manual-title">自己查找</view><view class="manual-caption">选条件，直接看结果</view></view><text class="manual-chevron">去查找 ›</text></view></view>
  <view class="keyboard-space" style="height:{{keyboardHeight}}px" />
</view>
