.assistant-hero {
  background:#fff;
  border:1rpx solid #e8eef0;
  padding:28rpx;
  border-radius:26rpx;
}

.assistant-brand {
  display:flex;
  align-items:center;
  gap:10rpx;
}

.assistant-brand > image {
  width:38rpx;
  height:38rpx;
}

.title {
  font-size:39rpx;
  line-height:1.45;
  margin-top:20rpx;
  letter-spacing:-1rpx;
}

.subtitle {
  font-size:25rpx;
}

.section {
  margin:30rpx 0 18rpx;
}

.section-title {
  font-size:27rpx;
}

.suggestions {
  display:flex;
  flex-wrap:wrap;
  gap:12rpx;
}

.suggestion {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
  padding:16rpx 18rpx;
  background:#fff;
  border:1rpx solid #dce7e8;
  border-radius:18rpx;
  font-size:23rpx;
  color:#187553;
}

.suggestion > image {
  width:27rpx;
  height:27rpx;
  flex-shrink:0;
}

.answer {
  margin-top:28rpx;
  line-height:1.9;
  font-size:27rpx;
}

.answer > text {
  white-space:pre-wrap;
}

.result {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15rpx;
  border-top:1rpx solid #edf1f2;
  margin-top:17rpx;
  padding-top:17rpx;
  color:#243b37;
}

.result.navigable {
  color:#187553;
}

.result > image {
  width:30rpx;
  height:30rpx;
  flex-shrink:0;
}
