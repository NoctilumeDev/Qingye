.title {
  font-size:47rpx
}

.notice-tabs {
  display:flex;
  gap:12rpx;
  padding:8rpx;
  margin-top:28rpx;
  border-radius:24rpx;
  background:#e7f2ed
}

.notice-tab {
  flex:1;
  font-size:26rpx;
  line-height:2.8;
  color:#60736f;
  background:transparent;
  border-radius:18rpx
}

.notice-tab.active {
  color:#187553;
  background:#fff;
  font-weight:700
}

.trash-hint {
  font-size:24rpx;
  line-height:1.8;
  color:#60736f;
  margin-top:20rpx
}

.notice-toolbar {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
  margin:32rpx 0 18rpx;
  flex-wrap:wrap
}

.notice-actions {
  display:flex;
  gap:14rpx
}

.notice-actions button[disabled] {
  opacity:.45
}

.selection-toolbar button[disabled] {
  opacity:.45
}

.selected-notice {
  border-color:#187553
}

.notice-checkbox {
  margin-right:12rpx;
  vertical-align:middle
}

.notice-pressed {
  opacity:.85
}

.notice-title {
  font-size:28rpx;
  font-weight:700;
  max-width:420rpx
}

.dot {
  color:#187553;
  font-size:19rpx
}

.notice-body {
  font-size:26rpx;
  color:#60736f;
  line-height:1.9;
  margin:22rpx 0
}
