<view class="page login">
  <view class="brand"><image src="/assets/icons/sparkling-fill-green.png" /><text>青野</text><text class="brand-en">QINGYE</text></view>
  <view wx:if="{{failure}}" class="login-failure">
    <text class="failure-code">{{failure.code}}</text>
    <view class="headline">{{failure.title}}</view>
    <view class="failure-description">{{failure.description}}</view>
    <view class="failure-actions"><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="retry">重新尝试</button><button class="secondary" disabled="{{busy}}" bindtap="backToLogin">返回登录</button></view>
  </view>
  <view wx:else>
  <view class="welcome"><image src="/assets/campus/campus-friends-v1.jpg" mode="aspectFill" /></view>
  <view class="headline">把青春，留在校园里。</view>
  <view class="subtitle">遇见同好，参加活动。<view>一起把课后的生活过得有声有色。</view></view>
  <view class="gap"><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="wechat">微信登录，开启校园生活</button></view>
  <button wx:if="{{!accounts.length}}" class="secondary" disabled="{{busy}}" bindtap="loadAccounts">重新载入体验身份</button>
  <view wx:if="{{accounts.length}}" class="demo">
    <view class="row"><text class="section-title">体验青野</text><text class="muted">本地演示</text></view>
    <view class="footnote">选一个身份，看看校园里正在发生什么。</view>
    <view wx:for="{{accounts}}" wx:key="id" class="account" data-id="{{item.id}}" bindtap="demo"><text>{{item.name}}</text><view class="account-enter">进入<image src="/assets/icons/arrow-right-s-line-muted.png" /></view></view>
  </view>
  <view class="footnote">青野 · 校园社团活动与共享资源</view>
  </view>
</view>
