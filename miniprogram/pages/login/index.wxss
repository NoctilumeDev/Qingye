.login {
  padding-top:15rpx;
}

.login-failure { margin-top:40rpx; padding:36rpx; background:#fff; border:1rpx solid #e4ecee; border-radius:28rpx; }
.failure-code { display:block; color:#187553; font-size:72rpx; font-weight:750; margin-bottom:28rpx; }
.failure-description { margin:24rpx 0 36rpx; color:#65767d; font-size:27rpx; line-height:1.8; }
.failure-actions { display:flex; flex-direction:column; gap:16rpx; }
.failure-actions button { width:100%; }

.brand {
  display:flex;
  align-items:center;
  gap:12rpx;
  font-size:36rpx;
  font-weight:750;
}

.brand > image {
  width:45rpx;
  height:45rpx;
}

.brand-en {
  font-size:19rpx;
  letter-spacing:3rpx;
  color:#65767d;
  margin-left:auto;
  font-weight:500;
}

.welcome {
  height:460rpx;
  border-radius:28rpx;
  margin:28rpx 0;
  overflow:hidden;
  background:#e1eff6;
}

.welcome > image {
  width:100%;
  height:100%;
  display:block;
}

.headline {
  font-size:39rpx;
  font-weight:750;
  line-height:1.4;
}

.subtitle {
  font-size:25rpx;
}

.demo {
  margin-top:40rpx;
}

.account {
  background:#fff;
  border:1rpx solid #e4ecee;
  border-radius:22rpx;
  padding:26rpx;
  margin-top:16rpx;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12rpx;
  font-size:26rpx;
}

.account-enter {
  display:flex;
  align-items:center;
  color:#187553;
  font-size:24rpx;
  white-space:nowrap;
}

.account-enter > image {
  width:27rpx;
  height:27rpx;
}
