.activity-directory { padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); }
.search-row { display:flex; align-items:center; gap:20rpx; margin-bottom:24rpx; }
.search-box { flex:1; display:flex; align-items:center; min-width:0; padding:16rpx 22rpx; border-radius:40rpx; background:#edf2f4; gap:12rpx; }
.search-box image { width:30rpx; height:30rpx; }
.search-box input { flex:1; min-width:0; height:48rpx; font-size:28rpx; }
.search-submit { color:#187553; padding:16rpx 0; }
.clear { padding:0 8rpx; font-size:36rpx; }
.search-history { margin-bottom:26rpx; padding:22rpx; border:1rpx solid #e3ece7; border-radius:24rpx; background:#fff; }
.history-title { font-size:26rpx; font-weight:650; }
.history-tags { display:flex; flex-wrap:wrap; gap:14rpx; margin-top:20rpx; }
.history-tag { display:flex; align-items:stretch; max-width:100%; background:#eef5f1; border-radius:28rpx; font-size:25rpx; }
.history-word { display:flex; align-items:center; padding:14rpx 0 14rpx 22rpx; min-width:0; word-break:break-all; }
.history-remove { display:flex; align-items:center; justify-content:center; width:80rpx; min-height:80rpx; flex-shrink:0; color:#65767d; font-size:32rpx; }
.history-close { padding-top:20rpx; text-align:right; font-size:24rpx; color:#65767d; }
.list-heading { font-size:30rpx; font-weight:650; margin:26rpx 0; }
.chips {
  white-space:nowrap;
  margin-bottom:24rpx;
}

.chip {
  display:inline-block;
  padding:13rpx 26rpx;
  font-size:24rpx;
  color:#6c7c82;
  background:#edf2f4;
  border-radius:32rpx;
  margin-right:12rpx;
}

.chip.selected {
  background:#187553;
  color:#fff;
}
