<view class="page">
    <view class="profile">
      <view class="avatar">{{initial}}</view>
      <view>
        <view class="profile-name" bindtap="rename">{{user.name}} ✎</view>
        <text class="muted">把校园生活，过成喜欢的样子。</text>
      </view>
    </view>
    <view class="menu card">
      <view class="menu-row" bindtap="notifications">
        <text>✉ 我的消息</text>
        <text class="badge">{{unread ? unread + ' 条未读' : '去看看'}} ↗</text>
      </view>
      <view wx:if="{{user.workbench}}" class="menu-row" bindtap="workbench">
        <text>▦ 校园工作台</text>
        <text class="link">{{user.admin ? '管理员' : '社团负责人'}} ↗</text>
      </view>
      <view class="menu-row" bindtap="logout">
        <text>切换体验身份 / 退出登录</text>
        <text class="link">↗</text>
      </view>
    </view>
    <view class="section">
      <text class="section-title">我的活动</text>
      <text class="muted">每一次参与，都算数</text>
    </view>
    <activity-card wx:for="{{items}}" wx:key="id" item="{{item}}" bindopen="open" />
    <view wx:if="{{!items.length}}" class="empty">你的校园故事还没开始。<view>去发现页，挑一个喜欢的活动吧。</view>
    </view>
  </view>
