.profile {
  display:flex;
  align-items:center;
  gap:23rpx;
  margin:12rpx 0 30rpx;
}

.avatar {
  width:110rpx;
  height:110rpx;
  line-height:110rpx;
  text-align:center;
  background:#e0f0e8;
  border-radius:50%;
  color:#187553;
  font-size:43rpx;
  font-weight:700;
  overflow:hidden;
  flex-shrink:0;
}

.avatar > image {
  width:100%;
  height:100%;
}

.profile-content {
  flex:1;
  min-width:0;
}

.profile-name {
  display:flex;
  align-items:center;
  gap:10rpx;
  font-size:31rpx;
  font-weight:700;
  line-height:1.5;
  margin-bottom:8rpx;
}

.profile-name > image {
  width:28rpx;
  height:28rpx;
  flex-shrink:0;
}

.profile-name > text {
  flex:1;
  min-width:0;
  word-break:break-all;
}

.profile .muted {
  font-size:23rpx;
}

.profile-stats {
  display:flex;
  justify-content:space-around;
  text-align:center;
  padding:15rpx 0 34rpx;
}

.profile-stats > view {
  flex:1;
  color:#65767d;
  font-size:22rpx;
}

.profile-stats text {
  display:block;
  color:#243b37;
  font-size:30rpx;
  font-weight:700;
  margin-bottom:10rpx;
}

.profile-stat {
  padding:12rpx 0;
  border-radius:18rpx;
  min-height:96rpx;
}

.stat-pressed {
  background:#eaf2f4;
}

.stat-label {
  display:flex;
  justify-content:center;
  align-items:center;
  gap:3rpx;
}

.stat-label > image {
  width:22rpx;
  height:22rpx;
}

.menu {
  padding:4rpx 24rpx;
}

.menu-row {
  padding:25rpx 0;
  min-height:100rpx;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
  border-bottom:1rpx solid #edf1f2;
  font-size:26rpx;
}

.menu-row:last-child {
  border:0;
}

.menu-label {
  display:flex;
  align-items:center;
  gap:17rpx;
}

.menu-label > image {
  width:33rpx;
  height:33rpx;
  flex-shrink:0;
}

.menu-end {
  display:flex;
  align-items:center;
  gap:8rpx;
}

.menu-end > image,.chevron {
  width:30rpx;
  height:30rpx;
  flex-shrink:0;
}

.notice-count {
  background:#ec7858;
  color:#fff;
  border-radius:30rpx;
  min-width:35rpx;
  padding:3rpx 9rpx;
  text-align:center;
  font-size:21rpx;
}

.campus-footer {
  margin-top:25rpx;
  height:460rpx;
  border-radius:26rpx;
  overflow:hidden;
  background:#e1eff6;
}

.campus-footer > image {
  width:100%;
  height:100%;
  display:block;
}

.profile-edit-mask {
  position:fixed;
  inset:0;
  z-index:1000;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:36rpx;
  background:rgba(25,47,41,.3);
}

.profile-edit-dialog {
  width:100%;
  max-width:640rpx;
  padding:36rpx;
  border-radius:30rpx;
  background:#fff;
  transition:transform .18s cubic-bezier(.2,.8,.2,1);
}

.edit-heading {
  display:flex;
  align-items:center;
  gap:16rpx;
}

.edit-symbol {
  display:flex;
  align-items:center;
  justify-content:center;
  width:64rpx;
  height:64rpx;
  border-radius:20rpx;
  background:#e8f3ed;
}

.edit-symbol > image {
  width:34rpx;
  height:34rpx;
}

.edit-title {
  font-size:35rpx;
  font-weight:700;
  color:#243b37;
}

.edit-caption {
  margin:18rpx 0 30rpx;
  font-size:24rpx;
  line-height:1.6;
  color:#65767d;
}

.edit-label {
  display:block;
  font-size:24rpx;
  font-weight:600;
  margin-bottom:12rpx;
}

.edit-input {
  height:92rpx;
  padding:0 24rpx;
  border:2rpx solid #dce8e3;
  border-radius:18rpx;
  background:#f7faf8;
  color:#243b37;
  font-size:29rpx;
}

.edit-identity {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
  margin:22rpx 0 32rpx;
  font-size:24rpx;
  color:#65767d;
}

.edit-actions {
  display:flex;
  gap:18rpx;
}

.edit-actions > button {
  flex:1;
  min-height:88rpx;
}

.edit-error {
  color:#a44734;
  font-size:24rpx;
  margin:-12rpx 0 24rpx;
}
