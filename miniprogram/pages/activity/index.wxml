<view wx:if="{{item}}" class="page">
    <view class="poster">
      <image src="{{item.cover}}" mode="aspectFill" binderror="imageError" />
      <text class="poster-tag">{{item.categoryName}} / {{item.phase}}</text>
    </view>
    <view class="section">
      <text class="badge">{{item.clubName}}</text>
      <text class="muted">{{item.registeredCount}} / {{item.capacity}} 人报名</text>
    </view>
    <view class="title activity-title">{{item.title}}</view>
    <view class="info card">
      <view class="info-line"><image src="/assets/icons/time-line-ink.png" /><text>{{item.displayTime}} — {{displayEnd}}</text></view>
      <view class="info-line"><image src="/assets/icons/map-pin-line-ink.png" /><text>{{item.location}}</text></view>
      <view class="muted">报名截止：{{displayDeadline}}</view>
    </view>
    <view class="section">
      <text class="section-title">这次我们做什么</text>
    </view>
    <text class="description" selectable="true">{{item.description}}</text>
    <view wx:if="{{item.canManage}}" class="actions">
      <qy-action variant="secondary" size="compact" bindactivate="participants">查看报名名单</qy-action>
      <qy-action wx:if="{{item.status === 'PENDING' || item.status === 'REJECTED'}}" variant="secondary" size="compact" bindactivate="edit">调整活动</qy-action>
    </view>
    <view wx:if="{{participants}}" class="card gap">
      <view class="section-title">报名名单</view>
      <view wx:for="{{participants}}" wx:key="id" class="participant">
        <text>{{item.name}}</text>
        <text class="muted">{{item.status === 'REGISTERED' ? '正式报名' : '候补'}}</text>
      </view>
      <view wx:if="{{!participants.length}}" class="empty">还没有同学报名。</view>
    </view>
    <view class="signup card">
      <block wx:if="{{registrationText}}">
        <view class="row">
          <text class="badge">{{registrationText}}</text>
          <qy-action wx:if="{{canCancel}}" variant="secondary" size="compact" loading="{{busy}}" bindactivate="cancel">取消报名</qy-action>
        </view>
        <view class="footnote">{{registrationText === '候补中' ? '有人取消时，会按报名顺序递补并通知你。' : '已经为你记下这次活动，到时见。'}}</view>
      </block>
      <qy-action wx:elif="{{canRegister}}" variant="primary" loading="{{busy}}" bindactivate="register">{{item.slots ? '我要报名，一起去！' : '加入候补，等一个名额'}}</qy-action>
      <view wx:else="" class="muted">{{item.phase}}，当前不能报名。</view>
    </view>
  </view>
