<view class="page">
    <view class="row">
      <text class="eyebrow">CAMPUS WORKSPACE</text>
      <text class="badge">{{user.admin ? '管理员' : '社团负责人'}}</text>
    </view>
    <view class="title gap">让好事，<view>顺利发生。</view>
    </view>
    <view class="actions">
      <button class="primary small" bindtap="createActivity">＋ 发起活动</button>
      <button class="secondary small" bindtap="equipment">共享器材室 ↗</button>
      <button wx:if="{{user.admin}}" class="secondary small" bindtap="createClub">＋ 创建社团</button>
    </view>
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="tab">{{item.name}}</view>
    </view>
    <block wx:if="{{tab === 'activities'}}">
      <view wx:for="{{activities}}" wx:key="id" class="card">
        <view class="row">
          <text class="badge {{item.tone}}">{{item.phase}}</text>
          <text class="muted">{{item.clubName}}</text>
        </view>
        <view class="record-title" data-id="{{item.id}}" bindtap="detail">{{item.title}} ↗</view>
        <view class="muted">{{item.displayTime}} · {{item.registeredCount}} / {{item.capacity}} 人报名</view>
        <view wx:if="{{item.reviewNote}}" class="footnote">审核意见：{{item.reviewNote}}</view>
        <view class="actions">
          <block wx:if="{{user.admin && item.status === 'PENDING'}}">
            <button class="primary small" disabled="{{busy}}" data-kind="activities" data-id="{{item.id}}" data-action="approve" bindtap="operation">批准发布</button>
            <button class="danger small" disabled="{{busy}}" data-kind="activities" data-id="{{item.id}}" data-action="reject" bindtap="operation">退回</button>
          </block>
          <button wx:if="{{item.status !== 'CANCELLED'}}" class="secondary small" disabled="{{busy}}" data-kind="activities" data-id="{{item.id}}" data-action="cancel" bindtap="operation">取消活动</button>
        </view>
      </view>
      <button wx:if="{{more}}" class="secondary" bindtap="more">查看更多活动</button>
      <view wx:if="{{!activities.length && !loading}}" class="empty">还没有可管理的活动，先发起一场吧。</view>
    </block>
    <block wx:if="{{tab === 'loans'}}">
      <view wx:for="{{loans}}" wx:key="id" class="card">
        <view class="row">
          <text class="badge {{item.overdue ? 'red' : 'blue'}}">{{item.overdue ? '逾期未还' : item.statusText}}</text>
          <text class="muted">{{item.clubName}}</text>
        </view>
        <view class="record-title">{{item.equipmentName}} × {{item.quantity}}</view>
        <view class="muted">{{item.activityTitle}}</view>
        <view class="muted">{{item.displayStart}} — {{item.displayEnd}}</view>
        <view class="footnote">申请人：{{item.applicantName}}<view wx:if="{{item.reason}}">用途：{{item.reason}}</view>
          <view wx:if="{{item.reviewNote}}">审核意见：{{item.reviewNote}}</view>
        </view>
        <view class="actions">
          <block wx:if="{{user.admin && item.status === 'PENDING'}}">
            <button class="primary small" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="approve" bindtap="operation">批准预约</button>
            <button class="danger small" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="reject" bindtap="operation">拒绝</button>
          </block>
          <button wx:if="{{user.admin && item.status === 'APPROVED'}}" class="primary small" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="checkout" bindtap="operation">确认领取</button>
          <button wx:if="{{user.admin && item.status === 'CHECKED_OUT'}}" class="primary small" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="return" bindtap="operation">确认整单归还</button>
          <button wx:if="{{item.status === 'PENDING' || item.status === 'APPROVED'}}" class="secondary small" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="cancel" bindtap="operation">取消申请</button>
        </view>
      </view>
      <view wx:if="{{!loans.length && !loading}}" class="empty">还没有器材申请，去器材室看看吧。</view>
    </block>
    <block wx:if="{{tab === 'members'}}">
      <view class="field">
        <picker range="{{clubNames}}" value="{{clubIndex}}" bindchange="club">
          <view class="picker">{{clubNames[clubIndex] || '暂无社团'}} ▾</view>
        </picker>
      </view>
      <button wx:if="{{clubs.length}}" class="secondary small" bindtap="editClub">编辑社团资料</button>
      <view class="gap">
        <view wx:for="{{members}}" wx:key="id" class="card">
          <view class="row">
            <text class="record-name">{{item.name}}</text>
            <text class="badge">{{item.role === 'MANAGER' ? '负责人' : item.statusText}}</text>
          </view>
          <view class="actions">
            <block wx:if="{{item.status === 'PENDING'}}">
              <button class="primary small" disabled="{{busy}}" data-id="{{item.userId}}" data-action="approve" bindtap="member">通过申请</button>
              <button class="danger small" disabled="{{busy}}" data-id="{{item.userId}}" data-action="reject" bindtap="member">拒绝</button>
            </block>
            <button wx:if="{{user.admin && item.status === 'ACTIVE' && item.role !== 'MANAGER'}}" class="secondary small" disabled="{{busy}}" data-id="{{item.userId}}" data-action="promote" bindtap="member">设为负责人</button>
            <button wx:if="{{user.admin && item.status === 'ACTIVE' && item.role === 'MANAGER'}}" class="secondary small" disabled="{{busy}}" data-id="{{item.userId}}" data-action="demote" bindtap="member">交接为普通成员</button>
          </view>
        </view>
      </view>
      <view wx:if="{{!members.length && !loading}}" class="empty">暂时没有成员申请。</view>
    </block>
    <view wx:if="{{loading}}" class="loading">正在整理工作台…</view>
  </view>
