<view class="page">
    <view class="row">
      <text class="eyebrow">CAMPUS WORKSPACE</text>
      <text class="badge">{{user.admin ? '管理员' : '社团负责人'}}</text>
    </view>
    <view class="title gap">让好事，<view>顺利发生。</view>
    </view>
    <view class="actions">
      <qy-action variant="primary" size="compact" bindactivate="createActivity">＋ 发起活动</qy-action>
      <qy-action variant="secondary" size="compact" bindactivate="equipment">共享器材室 ↗</qy-action>
      <qy-action wx:if="{{user.admin}}" variant="secondary" size="compact" bindactivate="createClub">＋ 创建社团</qy-action>
    </view>
    <view class="tabs">
      <view wx:for="{{tabs}}" wx:key="key" class="tab {{tab === item.key ? 'selected' : ''}}" data-key="{{item.key}}" bindtap="tab">{{item.name}}</view>
    </view>
    <block wx:if="{{tab === 'activities'}}">
      <view wx:for="{{activities}}" wx:key="id" class="card">
        <view class="row">
          <text class="badge {{item.tone}}">{{item.phase}}</text>
          <text class="muted">{{item.clubName}}</text>
        </view>
        <view class="record-title" data-id="{{item.id}}" bindtap="detail">{{item.title}} ↗</view>
        <view class="muted">{{item.displayTime}} · {{item.registeredCount}} / {{item.capacity}} 人报名</view>
        <view wx:if="{{item.reviewNote}}" class="footnote">审核意见：{{item.reviewNote}}</view>
        <view class="actions">
          <block wx:if="{{user.admin && item.status === 'PENDING'}}">
            <qy-action variant="primary" size="compact" disabled="{{busy}}" data-kind="activities" data-id="{{item.id}}" data-action="approve" bindactivate="operation">批准发布</qy-action>
            <qy-action variant="danger" size="compact" disabled="{{busy}}" data-kind="activities" data-id="{{item.id}}" data-action="reject" bindactivate="operation">退回</qy-action>
          </block>
          <qy-action wx:if="{{item.status !== 'CANCELLED'}}" variant="secondary" size="compact" disabled="{{busy}}" data-kind="activities" data-id="{{item.id}}" data-action="cancel" bindactivate="operation">取消活动</qy-action>
        </view>
      </view>
      <qy-action wx:if="{{more}}" variant="secondary" bindactivate="more">查看更多活动</qy-action>
      <view wx:if="{{!activities.length && !loading}}" class="empty">还没有可管理的活动，先发起一场吧。</view>
    </block>
    <block wx:if="{{tab === 'loans'}}">
      <view wx:for="{{loans}}" wx:key="id" class="card">
        <view class="row">
          <text class="badge {{item.overdue ? 'red' : 'blue'}}">{{item.overdue ? '逾期未还' : item.statusText}}</text>
          <text class="muted">{{item.clubName}}</text>
        </view>
        <view class="record-title">{{item.equipmentName}} × {{item.quantity}}</view>
        <view class="muted">{{item.activityTitle}}</view>
        <view class="muted">{{item.displayStart}} — {{item.displayEnd}}</view>
        <view class="footnote">申请人：{{item.applicantName}}<view wx:if="{{item.reason}}">用途：{{item.reason}}</view>
          <view wx:if="{{item.reviewNote}}">审核意见：{{item.reviewNote}}</view>
        </view>
        <view class="actions">
          <block wx:if="{{user.admin && item.status === 'PENDING'}}">
            <qy-action variant="primary" size="compact" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="approve" bindactivate="operation">批准预约</qy-action>
            <qy-action variant="danger" size="compact" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="reject" bindactivate="operation">拒绝</qy-action>
          </block>
          <qy-action wx:if="{{user.admin && item.status === 'APPROVED'}}" variant="primary" size="compact" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="checkout" bindactivate="operation">确认领取</qy-action>
          <qy-action wx:if="{{user.admin && item.status === 'CHECKED_OUT'}}" variant="primary" size="compact" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="return" bindactivate="operation">确认整单归还</qy-action>
          <qy-action wx:if="{{item.status === 'PENDING' || item.status === 'APPROVED'}}" variant="secondary" size="compact" disabled="{{busy}}" data-kind="loans" data-id="{{item.id}}" data-action="cancel" bindactivate="operation">取消申请</qy-action>
        </view>
      </view>
      <view wx:if="{{!loans.length && !loading}}" class="empty">还没有器材申请，去器材室看看吧。</view>
    </block>
    <block wx:if="{{tab === 'members'}}">
      <view class="field">
        <picker range="{{clubNames}}" value="{{clubIndex}}" bindchange="club">
          <view class="picker">{{clubNames[clubIndex] || '暂无社团'}} ▾</view>
        </picker>
      </view>
      <qy-action wx:if="{{clubs.length}}" variant="secondary" size="compact" bindactivate="editClub">编辑社团资料</qy-action>
      <view class="gap">
        <view wx:for="{{members}}" wx:key="id" class="card">
          <view class="row">
            <text class="record-name">{{item.name}}</text>
            <text class="badge">{{item.role === 'MANAGER' ? '负责人' : item.statusText}}</text>
          </view>
          <view class="actions">
            <block wx:if="{{item.status === 'PENDING'}}">
              <qy-action variant="primary" size="compact" disabled="{{busy}}" data-id="{{item.userId}}" data-action="approve" bindactivate="member">通过申请</qy-action>
              <qy-action variant="danger" size="compact" disabled="{{busy}}" data-id="{{item.userId}}" data-action="reject" bindactivate="member">拒绝</qy-action>
            </block>
            <qy-action wx:if="{{user.admin && item.status === 'ACTIVE' && item.role !== 'MANAGER'}}" variant="secondary" size="compact" disabled="{{busy}}" data-id="{{item.userId}}" data-action="promote" bindactivate="member">设为负责人</qy-action>
            <qy-action wx:if="{{user.admin && item.status === 'ACTIVE' && item.role === 'MANAGER'}}" variant="secondary" size="compact" disabled="{{busy}}" data-id="{{item.userId}}" data-action="demote" bindactivate="member">交接为普通成员</qy-action>
          </view>
        </view>
      </view>
      <view wx:if="{{!members.length && !loading}}" class="empty">暂时没有成员申请。</view>
    </block>
    <view wx:if="{{loading}}" class="loading">正在整理工作台…</view>
  </view>
