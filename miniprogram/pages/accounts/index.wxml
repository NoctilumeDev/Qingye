<view class="page accounts-page">
  <view class="title">账号管理</view>
  <view class="subtitle">新账号默认是普通同学。核对账号后，再调整管理员权限。</view>
  <view class="account-search"><input class="field" value="{{searchText}}" maxlength="60" placeholder="搜索昵称或账号 ID" bindinput="input" bindconfirm="search" confirm-type="search" disabled="{{loading || busy}}" /><qy-action size="compact" variant="secondary" bindactivate="search" disabled="{{loading || busy}}">搜索</qy-action></view>
  <view wx:for="{{items}}" wx:key="id" class="card account-card">
    <view class="row"><view class="account-name">{{item.name}}{{item.id === user.id ? '（我）' : ''}}</view><text class="badge">{{!item.enabled ? '已停用' : item.admin ? '管理员' : '普通权限'}}</text></view>
    <view class="muted">账号 ID：{{item.id}}</view>
    <view wx:if="{{item.enabled}}" class="account-action"><qy-action variant="secondary" size="compact" data-id="{{item.id}}" bindactivate="changeRole" disabled="{{busy || loading}}">{{item.admin ? '撤销管理员' : '设为管理员'}}</qy-action></view>
  </view>
  <view wx:if="{{loading}}" class="loading">正在加载账号…</view>
  <view wx:elif="{{failed}}" class="empty">账号暂时没加载出来<view class="gap"><qy-action variant="secondary" bindactivate="retry">重新加载</qy-action></view></view>
  <view wx:elif="{{!items.length}}" class="empty">没有找到这个账号</view>
  <view wx:elif="{{finished}}" class="footnote">已显示全部匹配账号</view>
</view>
