<view class="page">
  <view class="club-heading"><view class="club-back" bindtap="back" hover-class="back-pressed" aria-role="button" aria-label="返回上一入口"><image src="/assets/icons/arrow-right-s-line-muted.png" mode="aspectFit" /></view><text class="eyebrow">FIND YOUR PEOPLE</text></view>
  <view class="title gap">同好，就在这里。</view>
  <view class="subtitle">兴趣让我们相遇，社团让故事继续。</view>
  <view class="section"><text class="section-title">校园社团</text><text class="muted">{{clubs.length}} 个有趣的角落</text></view>
  <view wx:for="{{clubs}}" wx:key="id" class="club card">
    <view class="club-main">
      <image class="club-cover" src="{{item.cover}}" mode="aspectFill" />
      <view class="club-content"><view class="club-title">{{item.name}}</view><view class="club-description">{{item.description}}</view></view>
    </view>
    <view class="club-bottom">
      <view class="club-members"><image src="/assets/icons/team-line-green.png" /><text>{{item.memberCount}} 位同学</text></view>
      <view class="club-actions">
        <text wx:if="{{item.myStatus === 'ACTIVE'}}" class="badge">{{item.myRole === 'MANAGER' ? '我是负责人' : '已加入'}}</text>
        <text wx:elif="{{item.myStatus === 'PENDING'}}" class="badge orange">入社申请审核中</text>
        <qy-action wx:else="" variant="primary" size="compact" data-id="{{item.id}}" bindactivate="join">申请加入</qy-action>
        <qy-action wx:if="{{item.myStatus === 'ACTIVE' && item.myRole !== 'MANAGER'}}" variant="secondary" size="compact" data-id="{{item.id}}" bindactivate="leave">退出社团</qy-action>
      </view>
    </view>
  </view>
  <view wx:if="{{loading}}" class="loading">正在打开社团名册…</view>
  <view wx:if="{{!loading && !clubs.length}}" class="empty">校园社团正在筹备中，过会儿再来看看。</view>
</view>
