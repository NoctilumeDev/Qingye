.club {
  position:relative;
  overflow:hidden
}

.club.blue {
  background:#e0eff9
}

.club.green {
  background:#e7f1d0
}

.club.orange {
  background:#faf0dd
}

.club.red {
  background:#f8e8df
}

.club-symbol {
  font-size:53rpx;
  color:#23734f
}

.club-title {
  font-size:37rpx;
  font-weight:800;
  margin:20rpx 0 16rpx
}

.club-description {
  font-size:26rpx;
  color:#657863;
  line-height:1.85
}
