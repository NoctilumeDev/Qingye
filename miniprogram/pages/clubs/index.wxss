.club-heading {
  display:flex;
  align-items:center;
  gap:8rpx;
  margin:-22rpx 0 0 -20rpx;
}

page button.club-back {
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
  width:88rpx;
  height:88rpx;
  min-width:44px;
  min-height:44px;
  margin:0;
  padding:0;
  background:transparent;
}

.club-back > image {
  width:48rpx;
  height:48rpx;
  transform:rotate(180deg);
}

.back-pressed {
  background:#e8f3ef;
}

.title {
  font-size:43rpx;
}

.subtitle {
  font-size:25rpx;
}

.club {
  padding:23rpx;
  border-radius:25rpx;
}

.club-main {
  display:flex;
  align-items:flex-start;
  gap:22rpx;
}

.club-cover {
  width:160rpx;
  height:165rpx;
  border-radius:18rpx;
  flex-shrink:0;
  background:#edf2f4;
}

.club-content {
  flex:1;
  min-width:0;
}

.club-title {
  font-size:30rpx;
  font-weight:700;
  line-height:1.4;
  margin-bottom:12rpx;
}

.club-description {
  color:#65767d;
  font-size:24rpx;
  line-height:1.7;
}

.club-bottom {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
  margin-top:20rpx;
  padding-top:18rpx;
  border-top:1rpx solid #edf1f2;
}

.club-members {
  display:flex;
  align-items:center;
  gap:8rpx;
  font-size:22rpx;
  color:#65767d;
  white-space:nowrap;
}

.club-members > image {
  width:29rpx;
  height:29rpx;
}

.club-actions {
  display:flex;
  flex-wrap:wrap;
  justify-content:flex-end;
  align-items:center;
  gap:12rpx;
}
