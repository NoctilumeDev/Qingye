.assistant-hero {
  padding:8rpx 4rpx 2rpx;
}
.assistant-brand { display:flex; align-items:center; gap:10rpx; }
.assistant-brand > image { width:38rpx; height:38rpx; }
.title { font-size:42rpx; line-height:1.4; margin-top:18rpx; letter-spacing:-1rpx; }
.subtitle { font-size:25rpx; margin-top:8rpx; }

.ask-card {
  margin-top:22rpx;
  padding:24rpx;
  border-radius:28rpx;
  background:#fff;
  border:1rpx solid #e1e9e6;
  box-shadow:0 12rpx 32rpx rgba(36,59,55,.06);
}
.ask-card .field { margin:0 0 18rpx; }
.ask-input { height:164rpx; background:#f8fbfa; border-color:#e2ebe7; }
.ask-note { margin-top:16rpx; color:#73827e; font-size:22rpx; line-height:1.65; }

.section { margin:34rpx 0 18rpx; }
.section-title { font-size:29rpx; }
.examples { margin-top:30rpx; }
.examples-label { margin-bottom:14rpx; color:#6e8079; font-size:23rpx; }
.suggestions { display:flex; flex-wrap:wrap; gap:12rpx; }
.suggestion {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
  padding:16rpx 18rpx;
  background:#fff;
  border:1rpx solid #dce7e8;
  border-radius:18rpx;
  font-size:23rpx;
  color:#187553;
}
.suggestion > image { width:27rpx; height:27rpx; flex-shrink:0; }

.directory-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }
.manual-entry { margin-top:30rpx; border-top:1rpx solid #e3ece7; padding-top:22rpx; }
.manual-header { display:flex; align-items:center; justify-content:space-between; gap:20rpx; padding:12rpx 0; }
.manual-title { color:#244c3b; font-size:27rpx; font-weight:650; }
.manual-caption { color:#74827d; font-size:22rpx; margin-top:7rpx; }
.manual-chevron { color:#187553; font-size:23rpx; flex-shrink:0; }
.directory-tile {
  min-width:0;
  padding:22rpx;
  background:#fff;
  border:1rpx solid #dce7e8;
  color:#244c3b;
  text-align:left;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:7rpx;
  font-weight:650;
  border-radius:18rpx;
}
.directory-action { font-size:21rpx; color:#70817a; font-weight:400; }
.directory-tile-pressed { opacity:.78; }
.is-disabled { opacity:.5; }

.notice-card {
  margin-top:24rpx;
  padding:26rpx;
  border-radius:24rpx;
  border:1rpx solid #dfe8e4;
  background:#fff;
  line-height:1.75;
}
.notice-card.success { background:#eff8f3; border-color:#cfe7dc; }
.notice-card.pending { background:#eef7fa; border-color:#cfe5ec; }
.notice-card.unknown { background:#f5f4f1; border-color:#e3dfd7; }
.notice-card.warning { background:#f2f6f3; border-color:#d7e3dc; }
.notice-card.danger { background:#fff1ee; border-color:#efdad4; }
.notice-title { font-size:30rpx; font-weight:750; color:#244c3b; }
.notice-card.danger .notice-title { color:#9d4938; }
.notice-hint { color:#65767d; font-size:24rpx; margin-top:6rpx; }
.query-summary { padding:18rpx; margin-top:18rpx; border-radius:16rpx; background:rgba(255,255,255,.72); }
.query-summary > text { display:block; }
.query-summary-label { color:#187553; font-size:21rpx; font-weight:700; margin-bottom:6rpx; }
.answer-text { display:block; white-space:pre-wrap; margin-top:18rpx; font-size:25rpx; }
.notice-action { margin-top:18rpx; }
.scope-actions { margin-top:20rpx; }

.clarification-card { margin-top:24rpx; border-color:#cfe5ec; }
.question-text { display:block; margin:18rpx 0; font-size:28rpx; line-height:1.7; }
.saved-condition { background:#f2f8f5; color:#375d4e; border-radius:14rpx; padding:14rpx 16rpx; margin:10rpx 0; font-size:23rpx; }

.reply-input { height:140rpx; margin:18rpx 0; }
.retry-button { margin-top:18rpx; }


.facet-toggle-pressed,.correct-pressed { background:#e8f3ef; }
.facets { margin-top:18rpx; }
.facet-choice { padding:24rpx 12rpx; border-bottom:1rpx solid #e3eae5; font-size:28rpx; height:auto; }
.facet-action { margin-top:16rpx; }
.queued-card { margin:16rpx 0; padding:18rpx; background:#f7faf9; border-radius:16rpx; font-size:24rpx; line-height:1.6; }
.queued-actions { display:flex; gap:12rpx; margin-top:12rpx; }

.results-card { margin-top:24rpx; line-height:1.85; }
.section-answer { display:block; white-space:pre-wrap; margin:14rpx 0; }
.result-count { color:#5f706a; font-size:23rpx; margin-bottom:8rpx; }
.candidate-note { padding:14rpx 16rpx; border-radius:14rpx; background:#f2f6f3; color:#52675e; font-size:23rpx; margin:12rpx 0; }
.result-warning { padding:12rpx 14rpx; border-radius:12rpx; background:#f2f6f3; color:#52675e; font-size:22rpx; margin:10rpx 0; }
.empty-result { text-align:center; padding:40rpx 20rpx; color:#53655e; }
.empty-result > view { font-size:29rpx; font-weight:700; }
.empty-result > text { display:block; margin-top:8rpx; color:#7a8883; font-size:23rpx; }
.result.detail-card {
  display:block;
  padding:24rpx 0;
  margin-top:0;
  border-top:1rpx solid #edf1f2;
  color:#243b37;
  font-size:26rpx;
  line-height:1.8;
}
.detail-head { display:flex; justify-content:space-between; font-size:30rpx; font-weight:650; }
.detail-link { color:#187553; font-size:22rpx; margin-left:16rpx; flex-shrink:0; }
.detail-description { display:block; white-space:pre-wrap; margin-top:12rpx; color:#53655e; }
.muted { font-size:24rpx; color:#65767d; line-height:1.7; margin:12rpx 0; }
.correct { display:inline-flex; align-items:center; min-height:64rpx; margin:12rpx 0 0; padding:0 18rpx; line-height:2; border-radius:16rpx; font-size:23rpx; color:#187553; background:#fff; }

.query-feedback { margin-top:28rpx; padding-top:24rpx; border-top:1rpx solid #e1ece6; color:#31594b; font-size:26rpx; line-height:1.7; }
.feedback-title { font-weight:600; }
.feedback-actions { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:18rpx; }
.feedback-actions qy-action { flex:1; min-width:180rpx; }
.feedback-editor { margin-top:0; }
.feedback-input { display:block; width:100%; box-sizing:border-box; height:160rpx; margin-top:14rpx; padding:18rpx; border:1rpx solid #dce7e1; border-radius:16rpx; background:#f7faf8; color:#243b37; font-size:28rpx; }
.feedback-note { margin:20rpx 0; color:#53655e; font-size:24rpx; line-height:1.7; }

.question-context { display:flex; align-items:center; gap:24rpx; margin-top:28rpx; padding:18rpx 22rpx; border:2rpx solid #eaf3ef; border-radius:20rpx; background:#fff; line-height:1.7; }
.question-copy { flex:1; min-width:0; }
.question-label { display:block; font-size:22rpx; color:#6e8079; }
.question-value { display:block; margin-top:4rpx; font-size:30rpx; font-weight:600; white-space:pre-wrap; overflow-wrap:anywhere; }
.question-action { flex-shrink:0; }
.clarification-label { font-size:23rpx; color:#187553; font-weight:650; }
.context-toggle,.scope-toggle { margin-top:20rpx; color:#187553; font-size:24rpx; padding:8rpx 0; }
.manual-page { padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); }
.manual-page-heading { margin-bottom:28rpx; }
.manual-return { text-align:center; padding:28rpx 12rpx; color:#187553; font-size:25rpx; }
.manual-page .facets { padding:24rpx; border-radius:26rpx; background:#fff; border:1rpx solid #e1e9e6; }
.scope-row { display:flex; justify-content:space-between; gap:24rpx; padding:10rpx 0; font-size:24rpx; }
.scope-row > text:first-child { flex-shrink:0; color:#65767d; }
.scope-row > text:last-child { text-align:right; overflow-wrap:anywhere; }
.batch-toggle { color:#187553; font-size:24rpx; padding:24rpx 0 0; }
