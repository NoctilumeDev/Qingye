.assistant-hero {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16rpx;
  min-height:72rpx;
}
.assistant-brand { display:flex; align-items:center; gap:10rpx; color:#187553; font-size:24rpx; font-weight:650; }
.assistant-brand > image { width:38rpx; height:38rpx; }
.assistant-title { font-size:44rpx; font-weight:750; line-height:1.4; margin-top:36rpx; }
.assistant-subtitle { font-size:26rpx; margin-top:12rpx; color:#65767d; line-height:1.7; }
.new-question { flex-shrink:0; }

.ask-card {
  margin-top:22rpx;
  padding:24rpx;
  border-radius:28rpx;
  background:#fff;
  border:1rpx solid #e1e9e6;
  box-shadow:0 12rpx 32rpx rgba(36,59,55,.06);
}
.ask-input { height:180rpx; background:#f8fbfa; border-color:#e2ebe7; margin-bottom:22rpx; }
.compose-cancel { margin-top:16rpx; }

.results-section-title { font-size:29rpx; font-weight:750; }
.examples { margin-top:30rpx; }
.examples-label { margin-bottom:14rpx; color:#6e8079; font-size:23rpx; }
.suggestions { display:flex; flex-wrap:wrap; gap:12rpx; }
.suggestion {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12rpx;
  min-height:80rpx;
  padding:20rpx 18rpx;
  background:#fff;
  border:1rpx solid #dce7e8;
  border-radius:18rpx;
  font-size:23rpx;
  color:#187553;
}
.suggestion > image { width:27rpx; height:27rpx; flex-shrink:0; }

.directory-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }
.manual-entry { display:flex; justify-content:space-between; align-items:center; margin-top:28rpx; min-height:88rpx; padding:22rpx 8rpx; color:#187553; font-size:25rpx; }
.directory-tile {
  min-width:0;
  padding:22rpx;
  background:#fff;
  border:1rpx solid #dce7e8;
  color:#244c3b;
  text-align:left;
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:7rpx;
  font-weight:650;
  border-radius:18rpx;
}
.directory-action { font-size:21rpx; color:#70817a; font-weight:400; }
.directory-tile-pressed { opacity:.78; }
.is-disabled { opacity:.5; }

.notice-card {
  margin-top:24rpx;
  padding:26rpx;
  border-radius:24rpx;
  border:1rpx solid #dfe8e4;
  background:#fff;
  line-height:1.75;
}
.notice-card.pending,.notice-card.unknown,.notice-card.warning { border-color:#cfe0d7; }
.notice-card.danger { border-color:#e8ccc4; }
.notice-title { font-size:30rpx; font-weight:750; color:#244c3b; }
.notice-card.danger .notice-title { color:#9d4938; }
.answer-text { display:block; white-space:pre-wrap; margin-top:18rpx; font-size:25rpx; }
.notice-action { margin-top:18rpx; }
.scope-actions { margin-top:20rpx; }

.clarification-card { margin-top:24rpx; padding:28rpx; border:1rpx solid #cfe0d7; border-radius:28rpx; background:#fff; }
.question-text { display:block; margin:18rpx 0; font-size:28rpx; line-height:1.7; }
.saved-condition { background:#f2f8f5; color:#375d4e; border-radius:14rpx; padding:14rpx 16rpx; margin:10rpx 0; font-size:23rpx; }

.reply-input { height:140rpx; margin:18rpx 0; }
.retry-button { margin-top:18rpx; }


.facet-toggle-pressed { background:#e8f3ef; }
.facets { margin-top:18rpx; }
.facet-choice { padding:24rpx 12rpx; border-bottom:1rpx solid #e3eae5; font-size:28rpx; height:auto; }
.facet-action { margin-top:16rpx; }
.queued-card { margin:16rpx 0; padding:18rpx; background:#f7faf9; border-radius:16rpx; font-size:24rpx; line-height:1.6; }
.queued-actions { display:flex; gap:12rpx; margin-top:12rpx; }

.results-card { margin-top:24rpx; padding:24rpx; border:1rpx solid #dce7e1; border-radius:28rpx; background:#fff; line-height:1.7; }
.results-heading { padding:4rpx 4rpx 0; }
.result-tools { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin:8rpx 0 18rpx; }
.section-answer { display:block; white-space:pre-wrap; margin:14rpx 0; }
.result-count { color:#5f706a; font-size:23rpx; margin-bottom:8rpx; }
.candidate-note { padding:14rpx 16rpx; border-radius:14rpx; background:#f2f6f3; color:#52675e; font-size:23rpx; margin:12rpx 0; }
.result-warning { padding:12rpx 14rpx; border-radius:12rpx; background:#f2f6f3; color:#52675e; font-size:22rpx; margin:10rpx 0; }
.detail-card {
  display:block;
  padding:24rpx;
  margin:16rpx 0;
  border:1rpx solid #e1ebe5;
  border-radius:20rpx;
  background:#f8fbf9;
  color:#243b37;
  font-size:26rpx;
  line-height:1.8;
}
.detail-head { display:flex; align-items:flex-start; gap:12rpx; justify-content:space-between; margin-bottom:16rpx; }
.detail-name { font-size:30rpx; font-weight:700; min-width:0; overflow-wrap:anywhere; }
.detail-state { color:#536d60; border:1rpx solid #dce7e1; border-radius:8rpx; padding:2rpx 8rpx; font-size:20rpx; flex-shrink:0; }
.detail-meta { display:flex; gap:14rpx; font-size:25rpx; margin:8rpx 0; }
.detail-meta-label { min-width:52rpx; color:#657970; flex-shrink:0; }
.detail-meta > text:last-child { min-width:0; overflow-wrap:anywhere; }
.detail-link { display:flex; justify-content:space-between; align-items:center; min-height:80rpx; margin-top:16rpx; border-top:1rpx solid #e1ebe5; padding-top:12rpx; color:#187553; font-size:24rpx; }
.detail-description { display:block; white-space:pre-wrap; overflow-wrap:anywhere; margin-top:16rpx; color:#53655e; font-size:24rpx; }
.availability-note { color:#187553; font-size:25rpx; margin-top:10rpx; }
.muted { font-size:24rpx; color:#65767d; line-height:1.7; margin:12rpx 0; }

.query-feedback { margin-top:28rpx; padding-top:24rpx; border-top:1rpx solid #e1ece6; color:#31594b; font-size:26rpx; line-height:1.7; }
.feedback-actions { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:18rpx; }
.feedback-actions qy-action { min-width:180rpx; }
.feedback-editor { margin-top:0; }
.feedback-input { display:block; width:100%; box-sizing:border-box; height:160rpx; margin-top:14rpx; padding:18rpx; border:1rpx solid #dce7e1; border-radius:16rpx; background:#f7faf8; color:#243b37; font-size:28rpx; }
.feedback-note { margin:20rpx 0; color:#53655e; font-size:24rpx; line-height:1.7; }

.question-context { margin-top:20rpx; padding:22rpx 24rpx; border:1rpx solid #cfe0d7; border-radius:20rpx; background:#fff; line-height:1.7; }
.question-label { display:block; font-size:22rpx; color:#6e8079; }
.question-value { display:block; margin-top:4rpx; font-size:30rpx; font-weight:600; white-space:pre-wrap; overflow-wrap:anywhere; }
.question-supplement { margin-top:14rpx; padding-top:12rpx; border-top:1rpx solid #e4ece7; white-space:pre-wrap; overflow-wrap:anywhere; font-size:26rpx; }
.clarification-label { font-size:23rpx; color:#187553; font-weight:650; }
.context-toggle,.scope-toggle { display:flex; align-items:center; min-height:80rpx; color:#187553; font-size:24rpx; padding:16rpx 4rpx; }
.finding { display:flex; align-items:center; gap:14rpx; padding:36rpx 8rpx; color:#536d60; font-size:26rpx; }
.finding-dot { width:16rpx; height:16rpx; border-radius:50%; background:#187553; }
.manual-page { padding-bottom:calc(40rpx + env(safe-area-inset-bottom)); }
.manual-page-heading { margin-bottom:28rpx; }
.manual-title { font-size:42rpx; font-weight:800; line-height:1.4; margin-top:18rpx; letter-spacing:-1rpx; }
.manual-subtitle { font-size:25rpx; color:#65767d; line-height:1.8; margin-top:8rpx; }
.manual-return { text-align:center; padding:28rpx 12rpx; color:#187553; font-size:25rpx; }
.manual-page .facets { padding:24rpx; border-radius:26rpx; background:#fff; border:1rpx solid #e1e9e6; }
.scope-row { display:flex; justify-content:space-between; gap:24rpx; padding:10rpx 0; font-size:24rpx; }
.scope-row > text:first-child { flex-shrink:0; color:#65767d; }
.scope-row > text:last-child { text-align:right; overflow-wrap:anywhere; }
.batch-toggle { color:#187553; font-size:24rpx; padding:24rpx 0 0; }
