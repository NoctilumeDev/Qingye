<view wx:if="{{recoveryMessage}}" class="notice-card warning">
  <view class="notice-title">这次没有完成</view><text>{{recoveryMessage}}</text>
  <view class="notice-action"><qy-action variant="secondary" bindactivate="restart" disabled="{{busy}}">重新查找</qy-action></view>
</view>
<view wx:if="{{statusTitle && status !== 'QUERY' && !clarificationToken && !recoveryMessage}}" class="notice-card {{statusTone}}">
  <view class="notice-title">{{statusTitle}}</view>
  <text class="answer-text" user-select="{{true}}">{{status === 'CONFIRM_SCOPE' ? '当前服务还需要确认查询。' : answer || statusHint}}</text>
  <view wx:if="{{!manual && facetOpen}}" class="notice-action"><qy-action variant="secondary" bindactivate="correct">自己选择条件</qy-action></view>
  <view wx:if="{{status === 'CONFIRM_SCOPE' && sections.length === 1 && sections[0].confirmationToken}}" class="scope-actions">
    <view wx:for="{{sections[0].scopeRows}}" wx:key="label" class="scope-row"><text>{{item.label}}</text><text>{{item.value}}</text></view>
    <qy-action variant="primary" data-index="0" loading="{{busy}}" disabled="{{busy || (manual && formDirty)}}" bindactivate="confirmScope">开始查找</qy-action>
  </view>
</view>
<view wx:for="{{sections}}" wx:for-item="section" wx:for-index="sectionIndex" wx:key="key" wx:if="{{section.status === 'QUERY' || sections.length > 1}}" class="results-card">
  <view wx:if="{{sections.length > 1}}" class="results-section-title">第 {{sectionIndex + 1}} 项</view>
  <text wx:if="{{section.status !== 'QUERY'}}" class="section-answer">{{section.displayAnswer}}</text>
  <qy-action wx:if="{{section.status === 'CONFIRM_SCOPE' && section.confirmationToken}}" variant="primary" data-index="{{sectionIndex}}" disabled="{{busy || (manual && formDirty)}}" bindactivate="confirmScope">开始查找</qy-action>
  <view wx:if="{{section.status === 'QUERY'}}" class="results-heading">
    <view class="notice-title">{{section.resultTitle}}</view>
    <view wx:if="{{section.hasMore || !section.items.length}}" class="result-count">{{section.items.length ? '下面还可以加载更多' : '按这次的条件，没有匹配记录。'}}</view>
  </view>
  <view class="result-tools">
    <view wx:if="{{section.scopeRows.length}}" class="scope-toggle" data-index="{{sectionIndex}}" bindtap="toggleScope" aria-role="button" aria-expanded="{{section.scopeOpen}}">{{section.scopeOpen ? '收起条件 ∧' : '查看查找条件 ∨'}}</view>
    <qy-action wx:if="{{!manual && section.status === 'QUERY' && section.items.length && section.canContinue && !section.feedbackDone}}" variant="secondary" size="compact" data-index="{{sectionIndex}}" disabled="{{busy}}" bindactivate="missed">{{feedbackCopy.missed}}</qy-action>
  </view>
  <block wx:if="{{section.scopeOpen}}">
    <view wx:for="{{section.scopeRows}}" wx:key="label" class="scope-row"><text>{{item.label}}</text><text>{{item.value}}</text></view>
  </block>
  <view wx:for="{{section.displayWarnings}}" wx:key="*this" class="result-warning">{{item}}</view>
  <view wx:if="{{section.selectionRequired}}" class="candidate-note">有几条相近的记录，看看是哪一个。</view>
  <view wx:for="{{section.items}}" wx:for-item="item" wx:key="id" class="detail-card">
    <view class="detail-head"><text class="detail-name">{{item.displayName}}</text><text wx:if="{{item.stateLabel}}" class="detail-state">{{item.stateLabel}}</text></view>
    <view wx:if="{{item.timeText}}" class="detail-meta"><text class="detail-meta-label">{{section.intent === 'MY_LOANS' ? '计划使用' : '时间'}}</text><text>{{item.timeText}}</text></view>
    <view wx:if="{{item.location}}" class="detail-meta"><text class="detail-meta-label">地点</text><text>{{item.location}}</text></view>
    <view wx:if="{{item.clubName}}" class="detail-meta"><text class="detail-meta-label">社团</text><text>{{item.clubName}}</text></view>
    <view wx:if="{{item.activityTitle}}" class="detail-meta"><text class="detail-meta-label">活动</text><text>{{item.activityTitle}}</text></view>
    <view wx:if="{{section.intent === 'MY_LOANS'}}" class="detail-meta"><text class="detail-meta-label">数量</text><text>{{item.quantity}} 件</text></view>
    <view wx:if="{{section.intent === 'EQUIPMENT'}}" class="detail-meta"><text class="detail-meta-label">库存</text><text>共 {{item.totalQuantity}} 件，已借出 {{item.borrowedQuantity}} 件{{item.enabled ? '' : '（已停用）'}}</text></view>
    <view wx:if="{{item.availability}}" class="availability-note">所选时段可借 {{item.availability.availableQuantity}} 件（按当前预约）</view>
    <text wx:if="{{item.description}}" class="detail-description" user-select="{{true}}">{{item.description}}</text>
    <view wx:if="{{section.intent === 'ACTIVITIES' || section.intent === 'MY_REGISTRATIONS'}}" class="detail-link" data-index="{{sectionIndex}}" data-id="{{item.id}}" bindtap="open" aria-role="button" aria-label="查看{{item.displayName}}详情">查看详情 <text aria-hidden="true">›</text></view>
  </view>
  <qy-action wx:if="{{section.hasMore && section.nextToken}}" variant="secondary" data-index="{{sectionIndex}}" bindactivate="more" loading="{{busy}}" disabled="{{busy || (manual && formDirty)}}">再看一些</qy-action>
  <view wx:if="{{!manual && section.status === 'QUERY' && section.items.length && section.canContinue}}" class="query-feedback">
    <text wx:if="{{section.feedbackDone}}">{{feedbackCopy.thanks}}</text>
    <view wx:elif="{{feedbackIndex !== sectionIndex}}" class="feedback-actions">
      <qy-action variant="neutral" size="compact" data-index="{{sectionIndex}}" disabled="{{busy}}" bindactivate="found">{{feedbackCopy.found}}</qy-action>
    </view>
  </view>
</view>
<view wx:if="{{feedbackNote}}" class="feedback-note">{{feedbackNote}}</view>
