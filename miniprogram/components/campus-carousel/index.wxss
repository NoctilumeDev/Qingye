.hero-carousel,.hero-card { border-radius:26rpx; overflow:hidden; }
.hero-card,.hero-image { width:100%; height:100%; display:block; }
.hero-card { background:#e1eff6; }
.hero-controls { height:32rpx; display:flex; justify-content:center; align-items:center; gap:9rpx; }
.dot { width:8rpx; height:8rpx; border-radius:8rpx; background:#cdded7; transition:width 250ms ease; }
.dot.active { width:24rpx; background:#187553; }
