.activity-card {
  background:#fff;
  border:1rpx solid #e4eadc;
  border-radius:30rpx;
  overflow:hidden;
  margin-bottom:25rpx
}

.cover {
  height:230rpx;
  position:relative;
  overflow:hidden;
  background:#dcebaf
}

.cover.blue {
  background:#dcebf7
}

.cover.orange {
  background:#f4dfbd
}

.cover.red {
  background:#f4d8cb
}

.cover image {
  width:100%;
  height:100%
}

.symbol {
  position:absolute;
  font-size:130rpx;
  right:74rpx;
  top:28rpx;
  transform:rotate(-12deg)
}

.cover-caption {
  position:absolute;
  left:28rpx;
  bottom:32rpx;
  font-size:33rpx;
  font-weight:850;
  line-height:1.15;
  letter-spacing:-1rpx;
  color:#24432f
}

.category {
  position:absolute;
  top:20rpx;
  left:24rpx;
  background:#ffffffbc;
  border-radius:12rpx;
  padding:7rpx 14rpx;
  font-size:21rpx;
  color:#284b34
}

.orbit {
  position:absolute;
  border:2rpx solid #ffffff8c;
  border-radius:50%;
  width:420rpx;
  height:420rpx;
  right:-90rpx;
  top:-105rpx
}

.orbit.two {
  width:300rpx;
  height:300rpx;
  right:-30rpx;
  top:-45rpx
}

.content {
  padding:25rpx 28rpx
}

.meta {
  display:flex;
  justify-content:space-between;
  color:#7d8b7e;
  font-size:21rpx
}

.phase {
  color:#226647
}

.card-title {
  font-size:31rpx;
  font-weight:750;
  margin:14rpx 0;
  line-height:1.45
}

.when {
  color:#7d8b7e;
  font-size:23rpx
}

.bottom {
  display:flex;
  justify-content:space-between;
  align-items:center;
  color:#7d8b7e;
  font-size:22rpx;
  margin-top:18rpx
}

.arrow {
  background:#edf3e3;
  color:#226647;
  border-radius:50%;
  width:45rpx;
  height:45rpx;
  line-height:45rpx;
  text-align:center;
  font-size:30rpx
}

.reason {
  margin-top:15rpx;
  border-top:1rpx solid #edf0e8;
  padding-top:13rpx;
  color:#54785b;
  font-size:21rpx
}
