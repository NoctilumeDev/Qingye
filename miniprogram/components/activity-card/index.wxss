.activity-card {
  display:flex;
  gap:22rpx;
  background:#fff;
  border-radius:24rpx;
  padding:22rpx;
  margin-bottom:18rpx;
  border:1rpx solid #e9eef0;
  color:#243b37;
  overflow:hidden;
}

.pressed {
  opacity:.8;
}

.cover {
  flex-shrink:0;
  width:186rpx;
  height:206rpx;
  border-radius:18rpx;
  overflow:hidden;
  position:relative;
  background:#e7f0f2;
}

.cover > image {
  width:100%;
  height:100%;
  display:block;
}

.content {
  flex:1;
  min-width:0;
}

.card-title {
  font-size:29rpx;
  font-weight:700;
  line-height:1.45;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

.meta {
  display:flex;
  align-items:center;
  flex-wrap:wrap;
  gap:12rpx;
  margin:10rpx 0;
  font-size:19rpx;
}

.meta > text:first-child {
  color:#276f83;
  background:#e7f5f9;
  border-radius:7rpx;
  padding:3rpx 9rpx;
}

.phase {
  color:#187553;
}

.when {
  display:flex;
  align-items:center;
  gap:6rpx;
  color:#65767d;
  font-size:21rpx;
}

.when image,.capacity image {
  width:25rpx;
  height:25rpx;
  flex-shrink:0;
}

.location {
  color:#65767d;
  font-size:20rpx;
  margin-top:6rpx;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

.bottom {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8rpx;
  margin-top:15rpx;
  font-size:21rpx;
}

.capacity {
  display:flex;
  align-items:center;
  gap:6rpx;
}

.cta {
  background:#187553;
  color:#fff;
  border-radius:30rpx;
  padding:9rpx 21rpx;
  font-size:20rpx;
  white-space:nowrap;
}

.reason {
  margin-top:12rpx;
  color:#54766c;
  font-size:20rpx;
  line-height:1.5;
}

.tile {
  display:block;
  padding:0;
  margin-bottom:0;
  height:100%;
  border-radius:22rpx;
}

.tile .cover {
  width:100%;
  height:210rpx;
  border-radius:0;
}

.tile .content {
  padding:17rpx;
}

.tile .card-title {
  font-size:26rpx;
  height:76rpx;
  line-height:1.45;
}

.tile .meta {
  font-size:18rpx;
  gap:7rpx;
  margin:9rpx 0;
}

.tile .when {
  font-size:19rpx;
}

.tile .location {
  font-size:18rpx;
  margin-top:8rpx;
}

.tile .bottom {
  font-size:19rpx;
  margin-top:15rpx;
}

.tile .cta {
  font-size:18rpx;
  padding:9rpx 14rpx;
}

.category {
  position:absolute;
  left:14rpx;
  top:14rpx;
  background:#fff;
  color:#286549;
  padding:5rpx 12rpx;
  border-radius:7rpx;
  font-size:19rpx;
}
