<view class="activity-card" bindtap="open">
    <view class="cover {{item.tone}}">
      <image wx:if="{{item.poster}}" src="{{item.poster}}" mode="aspectFill" />
      <block wx:else="">
        <view class="orbit one" />
        <view class="orbit two" />
        <text class="symbol">{{item.symbol}}</text>
        <view class="cover-caption">
          <view>LET’S MEET</view>
          <view>ON CAMPUS</view>
        </view>
      </block>
      <text class="category">{{item.categoryName}}</text>
    </view>
    <view class="content">
      <view class="meta">
        <text>{{item.clubName}}</text>
        <text class="phase">{{item.phase}}</text>
      </view>
      <view class="card-title">{{item.title}}</view>
      <view class="when">{{item.displayTime}} · {{item.location}}</view>
      <view class="bottom">
        <text>{{item.registeredCount}} / {{item.capacity}} 人报名</text>
        <text class="arrow">↗</text>
      </view>
      <view wx:if="{{item.recommendationReason}}" class="reason">{{item.recommendationReason}}</view>
    </view>
  </view>
