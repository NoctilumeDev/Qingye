page {
  --green:#187553;
  --lime:#d4eaa1;
  --blue:#d0e8f9;
  --ink:#243b37;
  --muted:#65767d;
  --paper:#f7fafb;
  background:var(--paper);
  color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  font-size:28rpx;
}

view,text,input,textarea,button {
  box-sizing:border-box;
}

button {
  margin:0;
  font-size:27rpx;
  line-height:1.4;
  border-radius:22rpx;
}

button::after {
  border:0;
}

.page {
  padding:32rpx 32rpx 190rpx;
}

.eyebrow {
  font-size:20rpx;
  font-weight:700;
  letter-spacing:4rpx;
  color:var(--green);
}

.title {
  font-size:50rpx;
  font-weight:800;
  letter-spacing:-2rpx;
  line-height:1.2;
}

.subtitle {
  color:var(--muted);
  line-height:1.8;
  margin-top:14rpx;
}

.section {
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:44rpx 0 22rpx;
}

.section-title {
  font-size:33rpx;
  font-weight:750;
}

.link {
  font-size:24rpx;
  color:var(--green);
}

.card {
  background:#fff;
  border-radius:30rpx;
  padding:28rpx;
  border:1rpx solid #e8eef0;
  margin-bottom:22rpx;
}

.row {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18rpx;
}

.gap {
  margin-top:22rpx;
}

.muted {
  font-size:24rpx;
  color:var(--muted);
  line-height:1.6;
}

.badge {
  display:inline-block;
  padding:8rpx 16rpx;
  background:#e8f3ef;
  border-radius:12rpx;
  color:var(--green);
  font-size:21rpx;
  font-weight:600;
}

.badge.blue {
  background:#e7f5f9;
  color:#276f83;
}

.badge.orange {
  background:#fff1e8;
  color:#985229;
}

.badge.red {
  background:#fff0ed;
  color:#a44734;
}

/* Override the v2 default 184px width without changing the rounded button style. */
page button.primary {
  width:100%;
  margin:0;
  border-radius:22rpx;
  background:var(--green);
  color:#fff;
  padding:24rpx 30rpx;
  font-weight:650;
}

page button.secondary {
  width:100%;
  margin:0;
  border-radius:22rpx;
  background:#fff;
  color:var(--green);
  border:1rpx solid #dce7e8;
  padding:22rpx 28rpx;
}

page button.small {
  width:auto;
  margin:0;
  border-radius:22rpx;
  display:inline-block;
  padding:14rpx 22rpx;
  font-size:24rpx;
}

.danger {
  background:#ffe8e0;
  color:#a65340;
}

.actions {
  display:flex;
  gap:14rpx;
  flex-wrap:wrap;
  margin-top:22rpx;
}

.empty {
  padding:60rpx 30rpx;
  text-align:center;
  color:var(--muted);
  line-height:1.9;
}

.field {
  margin:30rpx 0;
}

.label {
  display:block;
  font-size:25rpx;
  font-weight:650;
  margin-bottom:14rpx;
}

.input,.picker,.textarea {
  background:#fff;
  border:1rpx solid #dfe8ec;
  border-radius:18rpx;
  padding:22rpx;
  min-height:88rpx;
  width:100%;
}

.textarea {
  height:190rpx;
}

.split {
  display:flex;
  gap:16rpx;
}

.split > view {
  flex:1;
  min-width:0;
}

.footnote {
  margin-top:24rpx;
  font-size:22rpx;
  color:var(--muted);
  line-height:1.8;
}

.loading {
  text-align:center;
  padding:30rpx;
  color:var(--muted);
}

.safe-bottom {
  padding-bottom:env(safe-area-inset-bottom);
}
